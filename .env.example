# Copy to .env.local. Without AHOLO_API_KEY the app runs in MOCK mode.
# Get a key at https://labs.aholo3d.com/api-keys (global keys and China keys are not interchangeable).
AHOLO_API_KEY=
AHOLO_BASE_URL=https://api.aholo.ai/global

# --- Overrides, only if the defaults are wrong ---
# Generator: G1-Turbo (default, fast) or G1 (slower, full quality)
# NEXT_PUBLIC_AHOLO_GEN_VERSION=G1-Turbo
# AHOLO_PART_SPLIT_PATH=/lux3d/v1/part-split/task/create   (default, from the official SDK)
# AHOLO_GET_TASK_PATH=/lux3d/v1/generate/task/get
# AHOLO_TASK_PARAM=taskid
# AHOLO_ASSET_TOKEN_URL=
# AHOLO_ASSET_HOSTS=.aholo.ai,.aholo3d.com,.kujiale.com

# Optional: Google Gemini for any-language chat understanding and vision quality checks
# (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash   (falls back to gemini-flash-lite-latest when busy)
# Alternative to Gemini: ANTHROPIC_API_KEY=
